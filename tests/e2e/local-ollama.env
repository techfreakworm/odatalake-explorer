# Environment for the e2e tests: the API runs against a local ollama (OpenAI-compatible) server.
# Override any value through the environment (E2E_ENV_FILE points the harness at another file).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:32b
# the only setting that switches qwen3 thinking off on ollama (poc/README.md, finding 8)
LLM_REASONING_EFFORT=none
# a local 32B model needs tens of seconds per answer
LLM_TIMEOUT_S=300
ASK_TIMEOUT_S=420
QUEUE_WAIT_S=400
MAX_CONCURRENCY=1
INDEX_DIR=data/index
FASTEMBED_CACHE_PATH=.cache/models
LOG_LEVEL=INFO
