# Ask OLake configuration: every environment variable the app, the index builder, the eval runner and the deploy
# scripts read. Copy it to .env (gitignored) and fill in what you need: `cp .env.example .env`.
#
# MINIMUM TO DEPLOY
#   LLM_BASE_URL, LLM_API_KEY, LLM_MODEL   the primary provider: any OpenAI-compatible endpoint
#   PROJECT                                the GCP project, for Cloud Run (deploy/deploy.sh)
#   Recommended: a paid fallback provider (LLM_FALLBACK_BASE_URL, LLM_FALLBACK_API_KEY, LLM_FALLBACK_MODEL).
#   This file is the one place to fill. Load it with set -a; source .env; set +a before deploy/deploy.sh, which takes
#   each provider's BASE_URL, MODEL and REASONING_EFFORT from it (and prints them), and the keys for Secret Manager
#   or DigitalOcean SECRET envs (WAKEUP.md steps 5 and 6). deploy/env.yaml holds only the hosts' tuning defaults
#   (ABSTAIN_THRESHOLD, timeouts, limits), so the tuning variables below apply to local runs and the ngrok path.
# Everything else is optional and has a working default: the reasoning settings, the Gemini fallback
# (LLM_FALLBACK2_*), GITHUB_TOKEN, the retrieval, serving and refresher knobs, the judge, MAX_INSTANCES and the other
# Cloud Run sizes, and the DigitalOcean and ngrok settings.
# Live lines are only what you fill: the providers, GITHUB_TOKEN and PROJECT. Everything else is commented out with
# its default, because a live line resets an exported value (or the default) every time this file is sourced.
# Uncomment a line only to change it.
#
# An empty value counts as unset. Never commit real values: on the hosts, keys live in Google
# Secret Manager (deploy/deploy.sh secrets) or DigitalOcean SECRET envs, and deploy/env.yaml holds the tuning defaults.
# Load it into a shell with: set -a; source .env; set +a      (uvicorn: uv run --env-file .env uvicorn app.main:app)

# ----------------------------------------------------------------------------- LLM chain (contract I4)
# LLM chain (OpenAI-compatible), tried in order: 1) your main provider, 2) a PAID fallback with >= 100 RPM (OpenAI
# gpt-6-luna, a Groq developer key, or prepaid DigitalOcean; D7), 3) Gemma on the Gemini free tier, last.
# A provider is used only when its BASE_URL, API_KEY and MODEL are all set; with none set, /ask returns the degraded
# answer (the most relevant pages, sources set). No defaults.
# 1) Primary: your main provider, the event credits if you have them, otherwise your own paid key.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Lowest reasoning setting the model supports (e.g. low or minimal on Gemini 3); leave empty for non-reasoning models.
# Applies to the primary only; each fallback has its own variable below.
LLM_REASONING_EFFORT=
# 2) The paid fallback, e.g. OpenAI (https://api.openai.com/v1), Groq (https://api.groq.com/openai/v1) or DigitalOcean (https://inference.do-ai.run/v1)
#    Keys: OpenAI https://platform.openai.com/api-keys; Groq https://console.groq.com/keys; DigitalOcean: the control
#    panel's serverless inference page (create a model access key; inference is prepaid). Set a spend cap (D7).
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_REASONING_EFFORT=
# 3) Last resort: Gemma 4 on Gemini's OpenAI-compatible endpoint (free tier only, about 15 RPM, data used by Google, unverified)
#    Key: Google AI Studio, https://aistudio.google.com/apikey
#    The base URL is pre-filled (as in plan Appendix C): until the key and model are set, the app logs a harmless
#    config_warning "LLM provider 'fallback2' skipped" at every start. deploy.sh leaves FALLBACK2 out of the deployed
#    env when its key is missing.
LLM_FALLBACK2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK2_API_KEY=
LLM_FALLBACK2_MODEL=
LLM_FALLBACK2_REASONING_EFFORT=

# ----------------------------------------------------------------------------- Retrieval
# Index root: data/index/CURRENT names the active version (default data/index; relative to the repo root)
# INDEX_DIR=data/index
# Query and passage embedder (default BAAI/bge-small-en-v1.5; the committed index was embedded with it)
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# hybrid (BM25 + dense, RRF k=60; default) or bm25 (the no-model fallback)
# RETRIEVAL_MODE=hybrid
# No reranker: off (default) or tinybert (FlashRank TinyBERT over the fused top 20). Measured on this index:
# tinybert moves MRR@10 0.854 -> 0.814 (eval/results/retrieval-tinybert.json vs retrieval-baseline.json), so it stays off
# RERANK=off
# Off-topic gate on the highest dense cosine: dense (default) or off. Threshold = the lowest must-answer gate score
# minus 0.02 (default 0.69; the retrieval baseline gives 0.6894, eval/results/retrieval-baseline.json). Recalibrate it
# from the "gate calibration" line of a full eval run (WAKEUP.md step 9).
# GATE_SIGNAL=dense
# ABSTAIN_THRESHOLD=0.69
# Prompt-leak canary: 16 hex characters, written by deploy.sh on every deploy (openssl rand -hex 8).
# Empty (or shorter than 8): a random one per process.
# CANARY=
# Repo citations in sources: branch (default; .../blob/master/<path>) or sha (the commit permalink with #L lines)
# SOURCE_URL_STYLE=branch
# Decision D4, decided by data: off (default). The blog is not in the index
# BLOG=off
# Optional, for the index refresher: a GitHub token makes REST calls free of the 60/hour unauthenticated limit.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens: "Public repositories" read-only
# access, no extra permissions.
GITHUB_TOKEN=

# ----------------------------------------------------------------------------- Serving
# onnxruntime threads for the query embedder (default 1); set it to the vCPU count
# ONNX_THREADS=1
# Generation cap on every LLM call (default 600 tokens)
# MAX_TOKENS=600
# Per LLM call timeout, seconds (default 25; shorter than any client's). It is also each provider attempt's
# first-byte bound inside ASK_TIMEOUT_S=30, so a hung primary leaves the fallback only about 5 s. The plan default stays
# 25 because reasoning models can take over 10 s to the first token (research.md §5.2), and fast failures (429, 5xx,
# connection refused) fail over at once anyway. If the primary's p95 time to first token in the smoke test is under
# about 8 s, set 12-15 so a hung primary leaves time for a fallback answer inside the 30 s bound (WAKEUP.md step 9).
# LLM_TIMEOUT_S=25
# Bounded wait for a concurrency slot, seconds (default 20; on expiry /ask returns the degraded 200 answer)
# QUEUE_WAIT_S=20
# The whole-/ask bound including the queue wait, seconds (default 30); on expiry the degraded 200 answer
# ASK_TIMEOUT_S=30
# In-flight LLM calls (default 8)
# MAX_CONCURRENCY=8
# Per-client token bucket (defaults 120/min, burst 200). Over the limit /ask returns the degraded answer, never a 429.
# Keep the burst above the test-set size, so one scorer IP sending the whole set never hits it (our set: 94 rows)
# RATE_LIMIT_PER_MIN=120
# RATE_LIMIT_BURST=200
# LLM tokens (prompt + completion) per UTC day (default 5,000,000; 0 disables it). When spent, /ask returns the
# degraded answer
# DAILY_TOKEN_BUDGET=5000000
# The deployment's public https URL (contract I4). The app reads it but nothing depends on it yet (default empty)
# PUBLIC_BASE_URL=
# In-app index refresher: poll interval in minutes (default 0 = off). On Cloud Run, deploy.sh adds
# --no-cpu-throttling when it is above 0
# REFRESH_INTERVAL_MIN=0
# DEBUG, INFO (default), WARNING or ERROR; logs are one JSON object per line on stdout
# LOG_LEVEL=INFO
# 1 enables POST /debug/retrieve and /openapi.json (local only; the eval runner's --retrieval-only needs it). Default 0
# DEBUG=0
# Shown in /healthz (default unknown). Left commented out: deploy.sh sets it per deploy from git rev-parse --short
# HEAD, and the image takes it as a build arg (docker build --build-arg GIT_SHA=$(git rev-parse --short HEAD) .), so
# an empty value here would blank it in a container started with --env-file .env.
# GIT_SHA=

# ----------------------------------------------------------------------------- Model and cache locations
# Left commented out: the defaults apply (relative to the repo root), and the image bakes its models in /app/models
# with HF_HUB_OFFLINE=1. Never pass these into the container (docker run --env-file .env): a relative path there
# would hide the baked models and startup would fail. The local-development block below may set them.
# fastembed models (and FlashRank under <path>/flashrank). Default .cache/models
# FASTEMBED_CACHE_PATH=.cache/models
# tiktoken's o200k_base encoding (used by the index builder and refresher). Default .cache/tiktoken
# TIKTOKEN_CACHE_DIR=.cache/tiktoken
# The index builder's cache: fetched HTML, shallow clones, GitHub responses, embeddings, poll state. Default .cache
# ASK_OLAKE_CACHE=.cache
# Set by the Dockerfile only: HF_HOME and HF_HUB_OFFLINE=1 (the Hugging Face cache, no hub calls at runtime), PORT=8080,
# PYTHONDONTWRITEBYTECODE, PYTHONUNBUFFERED, PATH, and at build time UV_COMPILE_BYTECODE, UV_LINK_MODE,
# UV_PYTHON_DOWNLOADS and UV_PROJECT_ENVIRONMENT. Build args: GIT_SHA (default unknown) and PYTHON_IMAGE (default
# python:3.12-slim).

# ----------------------------------------------------------------------------- Eval judge (uv run python -m eval.run --judge)
# Any OpenAI-compatible endpoint; each falls back to the LLM_* value of the same name, then to local ollama qwen3:32b.
# Prefer a stronger model from a different family than the generator (judges favour their own outputs).
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=
# Defaults to none for qwen3 models (the only setting that turns their thinking off on ollama), else unset
# JUDGE_REASONING_EFFORT=

# ----------------------------------------------------------------------------- Deploy (deploy/deploy.sh, deploy/ngrok.sh)
# Read from your shell by the scripts, not by the app.
# GCP project id, required for `secrets` and `primary` (WAKEUP.md steps 4-6 read it from here): the project picker
# at https://console.cloud.google.com/, or gcloud projects list. Billing must be enabled for Cloud Run.
PROJECT=
# Cloud Run region, service name, service account, memory (1Gi minimum, 4Gi for bge-base or a reranker), vCPUs and
# minimum instances
# REGION=asia-south1
# SERVICE=ask-olake
# SA_NAME=ask-olake-run
# MEMORY=2Gi
# CPU=1
# MIN_INSTANCES=1
# Cloud Run's instance cap (default 1, the plan's single-instance design). The daily token budget, rate limiter and
# concurrency cap are per process: with N instances, N x DAILY_TOKEN_BUDGET and N x MAX_CONCURRENCY toward the
# provider (and up to N x the per-IP rate limit; the answer cache splits too). Raise only if the provider's limits
# allow. The DigitalOcean spec keeps instance_count: 1 (.do/app.yaml).
# MAX_INSTANCES=1
# DigitalOcean App Platform fallback: the GitHub repo App Platform builds from (owner/name, required for `fallback`),
# its branch (default: the branch checked out here, refused when detached), the app name (the app id is looked up
# by it) and the size. doctl auth: https://cloud.digitalocean.com/account/api/tokens, then doctl auth init
# DO_REPO=
# DO_BRANCH=
# DO_APP_NAME=ask-olake
# DO_SIZE=apps-s-1vcpu-2gb
# deploy.sh smoke URL: concurrent /ask requests in the burst check (default 0 = no burst; the plan's check uses 50)
# SMOKE_BURST=0
# Emergency ngrok path: your one free dev domain (https://dashboard.ngrok.com/domains). The authtoken
# (https://dashboard.ngrok.com/get-started/your-authtoken) goes into `ngrok config add-authtoken <TOKEN>`, not here.
# NGROK_DOMAIN=
# deploy/ngrok.sh: the local port (default 8080) and the image (default ask-olake:local). Inside the container
# uvicorn listens on $PORT, which Cloud Run sets; ngrok.sh pins it to 8080 there.
# PORT=8080
# IMAGE=ask-olake:local

# ----------------------------------------------------------------------------- Local development (example values)
# Local ollama (http://127.0.0.1:11434/v1) with qwen3:32b: reasoning_effort none turns thinking off, and a local 32B
# model needs tens of seconds per answer, so raise the timeouts and run one request at a time.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:32b
# LLM_REASONING_EFFORT=none
# LLM_TIMEOUT_S=300
# ASK_TIMEOUT_S=420
# QUEUE_WAIT_S=400
# MAX_CONCURRENCY=1
# DEBUG=1
# Outside a container only:
# FASTEMBED_CACHE_PATH=.cache/models
# TIKTOKEN_CACHE_DIR=.cache/tiktoken

# ----------------------------------------------------------------------------- Test and verify knobs (not app config)
# Read by tests/e2e and scripts/verify.sh only.
# The env file the e2e harness starts the API with:
# E2E_ENV_FILE=tests/e2e/local-ollama.env
# Fail (instead of skip) when the e2e prerequisites are missing:
# E2E_REQUIRED=1
# How long the e2e tests wait for the shared ollama lock, seconds:
# E2E_LOCK_WAIT_S=600
# The caller already holds .cache/ollama.lock:
# OLLAMA_LOCK_HELD=1
# The branch point for verify.sh's commit-trailer check:
# VERIFY_BASE=soma/odatalake-explorer
# How long verify.sh waits for the ollama lock, seconds:
# VERIFY_LOCK_WAIT_S=600
